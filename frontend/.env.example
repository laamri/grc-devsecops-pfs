NEXT_PUBLIC_AUTH_API_URL=http://localhost:8001
NEXT_PUBLIC_TASK_API_URL=http://localhost:8002

# Optional server proxy, read at request time (defaults for local US06 APIs).
# Compose sets Docker service URLs and builds NEXT_PUBLIC_* as /api/auth,/api/task.
AUTH_INTERNAL_URL=http://127.0.0.1:8001
TASK_INTERNAL_URL=http://127.0.0.1:8002
