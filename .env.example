# US06: backend started directly on the host (process environment).
MONGO_URI=mongodb://localhost:27017/
CORS_ORIGINS=http://localhost:3000

# US07: optional Compose overrides; defaults also work without a .env file.
FRONTEND_PORT=3000
COMPOSE_IMAGE_TAG=us07
# A separate name prevents the local US06 URI from overriding Docker DNS.
COMPOSE_MONGO_URI=mongodb://mongo:27017/
